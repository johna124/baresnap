BT /F1 9.0 Tf 50.00 288.00 Td (    LOG_DIR="/var/log/baresnap") Tj ET
BT /F1 9.0 Tf 50.00 276.00 Td (    LOG_FILE="$LOG_DIR/backup_$\(date +%Y%m%d_%H%M%S\).log") Tj ET
BT /F1 9.0 Tf 50.00 264.00 Td (    # --- Preparation ---) Tj ET
BT /F1 9.0 Tf 50.00 252.00 Td (    mkdir -p "$LOG_DIR") Tj ET
BT /F1 9.0 Tf 50.00 240.00 Td (    # --- Run secure backup ---) Tj ET
BT /F1 9.0 Tf 50.00 228.00 Td (    echo "=== BareSnap backup: $\(date\) ===" >> "$LOG_FILE") Tj ET
BT /F1 9.0 Tf 50.00 216.00 Td (    echo "Repo: $REPO" >> "$LOG_FILE") Tj ET
BT /F1 9.0 Tf 50.00 204.00 Td (    echo "Source: $SOURCE" >> "$LOG_FILE") Tj ET
BT /F1 9.0 Tf 50.00 192.00 Td (    echo "---" >> "$LOG_FILE") Tj ET
BT /F1 9.0 Tf 50.00 180.00 Td (    if systemd-creds list | grep -q "baresnap-repo-key"; then) Tj ET
BT /F1 9.0 Tf 50.00 168.00 Td (        PASS="$\(systemd-creds cat baresnap-repo-key\)") Tj ET
BT /F1 9.0 Tf 50.00 156.00 Td (        if "$BARESNAP" --pass-fd 3 create "$REPO" "$SOURCE" >> "$LOG_FILE" 2>&1 ) Tj ET
