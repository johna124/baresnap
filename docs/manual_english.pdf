BT /F1 9.0 Tf 50.00 792.00 Td (    # 1. Local backup) Tj ET
BT /F1 9.0 Tf 50.00 780.00 Td (    "$BARESNAP" create "$REPO" "$SOURCE" || exit 1) Tj ET
BT /F1 9.0 Tf 50.00 768.00 Td (    # 2. Verify local integrity) Tj ET
BT /F1 9.0 Tf 50.00 756.00 Td (    "$BARESNAP" verify "$REPO" || exit 1) Tj ET
