BT /F1 9.0 Tf 50.00 624.00 Td (    kill $MOUNT_PID 2>/dev/null) Tj ET
BT /F1 9.0 Tf 50.00 612.00 Td (    fusermount -u /mnt/s3repo 2>/dev/null) Tj ET
