BT /F1 9.0 Tf 50.00 372.00 Td (    #!/bin/bash) Tj ET
BT /F1 9.0 Tf 50.00 360.00 Td (    # baresnap-backup.sh - Daily backup with log) Tj ET
BT /F1 9.0 Tf 50.00 348.00 Td (    set -euo pipefail) Tj ET
BT /F1 9.0 Tf 50.00 336.00 Td (    # --- Configuration ---) Tj ET
