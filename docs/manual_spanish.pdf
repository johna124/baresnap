BT /F1 9.0 Tf 50.00 480.00 Td (    set -euo pipefail) Tj ET
BT /F1 9.0 Tf 50.00 468.00 Td (    # --- Configuración ---) Tj ET
BT /F1 9.0 Tf 50.00 456.00 Td (    BARESNAP="/usr/local/bin/baresnap") Tj ET
BT /F1 9.0 Tf 50.00 444.00 Td (    REPO="/mnt/backup/repo") Tj ET
BT /F1 9.0 Tf 50.00 432.00 Td (    SOURCE="/home,/etc,/var/www") Tj ET
BT /F1 9.0 Tf 50.00 420.00 Td (    LOG_DIR="/var/log/baresnap") Tj ET
BT /F1 9.0 Tf 50.00 408.00 Td (    LOG_FILE="$LOG_DIR/backup_$\(date +%Y%m%d_%H%M%S\).log") Tj ET
BT /F1 9.0 Tf 50.00 396.00 Td (    # --- Preparación ---) Tj ET
BT /F1 9.0 Tf 50.00 384.00 Td (    mkdir -p "$LOG_DIR") Tj ET
BT /F1 9.0 Tf 50.00 372.00 Td (    # --- Ejecutar backup seguro ---) Tj ET
BT /F1 9.0 Tf 50.00 360.00 Td (    echo "=== BareSnap backup: $\(date\) ===" >> "$LOG_FILE") Tj ET
BT /F1 9.0 Tf 50.00 348.00 Td (    echo "Repo: $REPO" >> "$LOG_FILE") Tj ET
BT /F1 9.0 Tf 50.00 336.00 Td (    echo "Source: $SOURCE" >> "$LOG_FILE") Tj ET
BT /F1 9.0 Tf 50.00 324.00 Td (    echo "---" >> "$LOG_FILE") Tj ET
BT /F1 9.0 Tf 50.00 312.00 Td (    if systemd-creds list | grep -q "baresnap-repo-key"; then) Tj ET
BT /F1 9.0 Tf 50.00 300.00 Td (        PASS="$\(systemd-creds cat baresnap-repo-key\)") Tj ET
BT /F1 9.0 Tf 50.00 288.00 Td (        if "$BARESNAP" --pass-fd 3 create "$REPO" "$SOURCE" >> "$LOG_FILE" 2>&1 ) Tj ET
BT /F1 9.0 Tf 50.00 276.00 Td (3<<<"$PASS"; then) Tj ET
BT /F1 9.0 Tf 50.00 264.00 Td (            unset PASS) Tj ET
BT /F1 9.0 Tf 50.00 252.00 Td (            echo "RESULT: OK" >> "$LOG_FILE") Tj ET
BT /F1 9.0 Tf 50.00 240.00 Td (            exit 0) Tj ET
BT /F1 9.0 Tf 50.00 228.00 Td (        else) Tj ET
BT /F1 9.0 Tf 50.00 216.00 Td (            RC=$?) Tj ET
BT /F1 9.0 Tf 50.00 204.00 Td (            unset PASS) Tj ET
BT /F1 9.0 Tf 50.00 192.00 Td (            echo "RESULT: ERROR \(code $RC\)" >> "$LOG_FILE") Tj ET
BT /F1 9.0 Tf 50.00 180.00 Td (            if command -v mail &>/dev/null; then) Tj ET
BT /F1 9.0 Tf 50.00 168.00 Td (                mail -s "[BareSnap] ERROR en backup $\(date +%Y-%m-%d\)" root < "$LOG_FILE") Tj ET
BT /F1 9.0 Tf 50.00 156.00 Td (            fi) Tj ET
BT /F1 9.0 Tf 50.00 144.00 Td (            exit $RC) Tj ET
BT /F1 9.0 Tf 50.00 132.00 Td (        fi) Tj ET
BT /F1 9.0 Tf 50.00 120.00 Td (    else) Tj ET
BT /F1 9.0 Tf 50.00 108.00 Td (        echo "RESULT: CRITICAL ERROR \(Credencial no encontrada\)" >> "$LOG_FILE") Tj ET
BT /F1 9.0 Tf 50.00 96.00 Td (        exit 2) Tj ET
BT /F1 9.0 Tf 50.00 84.00 Td (    fi) Tj ET
endstream
