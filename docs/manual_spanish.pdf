BT /F1 9.0 Tf 50.00 168.00 Td (# NUEVO ENFOQUE DE SEGURIDAD: Inyección efímera en memoria via --pass-fd) Tj ET
BT /F1 9.0 Tf 50.00 156.00 Td (# La passphrase viaja por un pipe anónimo, nunca toca el entorno ni argv.) Tj ET
BT /F1 9.0 Tf 50.00 144.00 Td (CREDENTIAL_NAME="baresnap-repo-key") Tj ET
BT /F1 9.0 Tf 50.00 132.00 Td (if systemd-creds list | grep -q "$CREDENTIAL_NAME"; then) Tj ET
BT /F1 9.0 Tf 50.00 120.00 Td (    PASS="$\(systemd-creds cat "$CREDENTIAL_NAME"\)") Tj ET
BT /F1 9.0 Tf 50.00 108.00 Td (    "$BARESNAP" --pass-fd 3 create "$REPO" "$SOURCE" \\) Tj ET
BT /F1 9.0 Tf 50.00 96.00 Td (        >> "$LOG_FILE" 2>&1 3<<<"$PASS") Tj ET
BT /F1 9.0 Tf 50.00 84.00 Td (    unset PASS) Tj ET
BT /F1 9.0 Tf 50.00 72.00 Td (else) Tj ET
